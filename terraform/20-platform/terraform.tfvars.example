# Copy this file to terraform.tfvars. Subscription IDs live in the shared
# ../subscriptions.tfvars file and are supplied with -var-file.

prefix          = "alzlab"
location        = "australiaeast"

# Keep false for the enterprise multi-subscription topology. Set true only
# when using subscriptions.single.tfvars for the documented fallback track.
allow_shared_subscription_ids = false
# Set true only with subscriptions.quota-limited.tfvars: four distinct
# platform IDs plus one protected existing workload ID.
allow_logical_workload_subscription_ids = false

# ---------------------------------------------------------------------------
# Cost toggles. Everything below bills by the hour while it exists.
# The VM, Private Endpoint and log ingestion can still incur baseline charges.
# ---------------------------------------------------------------------------

# Day 1-2: everything off except the VM. Build the topology, wire the private
# endpoint, prove DNS resolution. Costs almost nothing.
enable_firewall         = false
enable_vpn_gateway      = false
enable_simulated_onprem = false
enable_test_vm          = true
enable_sentinel         = false

# Day 3 (one afternoon): turn the firewall on, watch the effective routes
# change, break egress on purpose, read the logs in KQL, then turn it back off.
#   enable_firewall   = true
#   firewall_sku_tier = "Standard"   # or "Basic" to save ~2/3 of the cost

# Day 4 (one afternoon): hybrid connectivity. Both gateways take ~40 min to
# build, so start the apply and go do the reading.
#   enable_vpn_gateway      = true
#   enable_simulated_onprem = true
#   vpn_shared_key          = "set-a-local-random-value-at-least-16-characters"

log_retention_days = 30
