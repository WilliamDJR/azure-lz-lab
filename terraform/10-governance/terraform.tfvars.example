# Copy this file to terraform.tfvars. Subscription IDs live in the shared
# ../subscriptions.tfvars file and are supplied with -var-file.

# Must be unique in the tenant. If you re-run the lab, bump this rather than
# fighting soft-deleted management groups.
prefix = "alzlab"

root_display_name = "ALZ Lab (William)"

allowed_locations = ["australiaeast", "australiasoutheast", "global"]

# The assignment is created in DoNotEnforce mode first. Set true only after
# inventorying every existing resource and required region in the subscription.
enforce_allowed_locations_policy = false

# Day 1: leave false, look at the hierarchy in the portal first.
# Day 2: flip to true and watch the policies start evaluating.
move_subscriptions_into_hierarchy = false

# Keep false for the enterprise multi-subscription topology. Set true only
# when using subscriptions.single.tfvars for the documented fallback track.
allow_shared_subscription_ids = false
# Set true only with subscriptions.quota-limited.tfvars: four distinct
# platform IDs plus one protected existing workload ID.
allow_logical_workload_subscription_ids = false

# Single-subscription track only: the one subscription can have only one
# management-group parent. Corp is useful for the Policy inheritance exercise.
single_subscription_management_group_key = "corp"

# Quota-limited mode only: moving the protected workload subscription requires
# an owner-approved inventory because its existing resources inherit Policy.
allow_protected_workload_policy_inheritance = false

# Start with Audit. Switch to Deny on day 3 and try to create a VM with a
# public IP - seeing the deployment get rejected is the whole point.
public_ip_policy_effect = "Audit"

# Paste the log_analytics_workspace_id output from the 20-platform root here
# once it exists, then re-apply. This switches on the deployIfNotExists demo.
# log_analytics_workspace_id = "/subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/..."

# Optional FinOps controls. Use the first day of the CURRENT month; leave null
# until all subscription IDs are correct and the caller can create budgets.
# budget_start_date      = "2026-08-01T00:00:00Z"
# default_monthly_budget = 25
# monthly_budget_overrides = {
#   connectivity = 100
#   management   = 50
# }
# In single-subscription mode the sole `shared` budget uses the management
# override above; connectivity/corp/etc. overrides are intentionally ignored.
# budget_contact_emails = ["cloud-operations@example.com"]

# Optional examples. principal_id is an Entra object ID, not an email address.
# role_assignments = {
#   network_team = {
#     scope_key            = "connectivity"
#     principal_id         = "00000000-0000-0000-0000-000000000000"
#     role_definition_name = "Network Contributor"
#   }
# }
